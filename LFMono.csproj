<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Pedal LFmono.NET</AssemblyName>
    <RootNamespace>LFMono</RootNamespace>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>C:\Program Files\ReBuzz\Gear\Effects\</OutputPath>
  </PropertyGroup>

  <!--
    Copy BuzzGUI.Interfaces.dll and BuzzGUI.Common.dll from your ReBuzz
    installation into the same folder as this .csproj, then build.
  -->
  <ItemGroup>
    <Reference Include="BuzzGUI.Interfaces">
      <HintPath>BuzzGUI.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BuzzGUI.Common">
      <HintPath>BuzzGUI.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
